trains={
 "101":{"name":"Coast Express","stops":[("Chennai","08:00","08:05"),("T Nagar","08:20","08:22")],"days":{"Mon","Wed"}},
 "102":{"name":"Hill Line","stops":[("Chennai","09:00","09:05"),("Central","09:30","09:35")],"days":{"Tue","Wed"}},
 "103":{"name":"Lake Mail","stops":[("Central","10:00","10:05"),("Chennai","10:45","10:50")],"days":{"Mon"}},
 "104":{"name":"City Link","stops":[("T Nagar","11:00","11:02"),("Chennai","11:20","11:25")],"days":{"Wed"}},
 "105":{"name":"Valley Local","stops":[("Chennai","12:00","12:04")],"days":{"Fri"}},
}
station_index={}
for number,train in trains.items():
    for station,arrival,departure in train["stops"]:
        station_index.setdefault(station,[]).append((departure,number))
def departures(station,day):
    matches=[(dep,num) for dep,num in station_index.get(station,[])
             if day in trains[num]["days"]]
    return sorted(matches,key=lambda item:item[0])
for number,train in trains.items(): print(number,train["name"],train["stops"],sorted(train["days"]))
print("Chennai Wed:",departures("Chennai","Wed"))
print("Unknown:",departures("Nowhere","Wed"))
